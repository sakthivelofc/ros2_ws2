<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robot Properties -->
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_length" value="0.05"/>
  <xacro:property name="wheel_separation" value="0.4"/>
  <xacro:property name="wheelbase" value="0.3"/>
  <xacro:property name="chassis_length" value="0.5"/>
  <xacro:property name="chassis_width" value="0.3"/>
  <xacro:property name="chassis_height" value="0.1"/>
  <xacro:property name="chassis_mass" value="5.0"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <!-- Chassis visual/collision center above axle height -->
  <xacro:property name="chassis_z" value="0.15"/>
  <!-- Wheel axle height = wheel radius so wheels sit on z=0 -->
  <xacro:property name="wheel_z" value="${wheel_radius}"/>

  <xacro:macro name="box_inertia" params="m l w h xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (w*w + h*h) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${m * (l*l + h*h) / 12.0}"
        iyz="0.0"
        izz="${m * (l*l + w*w) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder inertia with axle along Y (matches joint axis) -->
  <xacro:macro name="cylinder_inertia_y" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (3*r*r + l*l) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${m * r*r / 2.0}"
        iyz="0.0"
        izz="${m * (3*r*r + l*l) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Dummy root (no inertia) so robot_state_publisher / KDL are happy -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="${chassis_mass}"
      l="${chassis_length}"
      w="${chassis_width}"
      h="${chassis_height}"
      xyz="0 0 ${chassis_z}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Wheel Macro: axle along +Y so DiffDrive +speed matches Gazebo & RViz -->
  <xacro:macro name="wheel" params="name x_pos y_pos">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${0.5 * 3.14159265359} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${0.5 * 3.14159265359} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}"/>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x_pos} ${y_pos} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Friction so DiffDrive can push the robot -->
    <gazebo reference="${name}">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxContacts>5</maxContacts>
    </gazebo>
  </xacro:macro>

  <!-- Create Four Wheels -->
  <xacro:wheel name="front_left_wheel"
               x_pos="${wheelbase/2}"
               y_pos="${wheel_separation/2}"/>

  <xacro:wheel name="front_right_wheel"
               x_pos="${wheelbase/2}"
               y_pos="${-wheel_separation/2}"/>

  <xacro:wheel name="rear_left_wheel"
               x_pos="${-wheelbase/2}"
               y_pos="${wheel_separation/2}"/>

  <xacro:wheel name="rear_right_wheel"
               x_pos="${-wheelbase/2}"
               y_pos="${-wheel_separation/2}"/>

  <!-- Publish joint states for robot_state_publisher / RViz -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- Gazebo Differential Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>my_robot/odom</frame_id>
      <child_frame_id>my_robot/base_footprint</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

      <max_linear_velocity>0.8</max_linear_velocity>
      <max_angular_velocity>0.7</max_angular_velocity>
    </plugin>
  </gazebo>

</robot>
