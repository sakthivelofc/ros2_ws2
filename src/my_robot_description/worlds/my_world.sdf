<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="my_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Sim systems (were missing — simulation could not run) -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.1 0.5 0.1 1</ambient>
            <diffuse>0.1 0.6 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Road -->
    <model name="road">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="road_link">
        <visual name="road_visual">
          <geometry>
            <box>
              <size>20 5 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left lane marking -->
    <model name="left_lane">
      <static>true</static>
      <pose>0 1.5 0.045 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <geometry>
            <box>
              <size>20 0.06 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right lane marking -->
    <model name="right_lane">
      <static>true</static>
      <pose>0 -1.5 0.045 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <geometry>
            <box>
              <size>20 0.06 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Center lane markings -->
    <model name="center_line_1">
      <static>true</static>
      <pose>-7 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <geometry>
            <box>
              <size>2 0.06 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="center_line_2">
      <static>true</static>
      <pose>-3 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <geometry>
            <box>
              <size>2 0.06 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="center_line_3">
      <static>true</static>
      <pose>1 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <geometry>
            <box>
              <size>2 0.06 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="center_line_4">
      <static>true</static>
      <pose>5 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <geometry>
            <box>
              <size>2 0.06 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Starting line -->
    <model name="starting_line">
      <static>true</static>
      <pose>-8 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 3 0.02</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left building -->
    <model name="left_building">
      <static>true</static>
      <pose>0 5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>4 2 3</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>1 0.4 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right building -->
    <model name="right_building">
      <static>true</static>
      <pose>4 -5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>4 2 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Road barriers -->
    <model name="left_barrier">
      <static>true</static>
      <pose>0 2.2 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.15 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.15 0.8</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="right_barrier">
      <static>true</static>
      <pose>0 -2.2 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.15 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.3 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.15 0.8</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
